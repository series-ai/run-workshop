{
  "version": 1,
  "targetDevice": "Samsung Galaxy S23 Ultra (Adreno 740, 120Hz = 8.33ms budget)",
  "mobilePolicy": {
    "maxDpr": 1.5,
    "shadowMaps": false,
    "blobShadow": true,
    "postProcessing": false,
    "maxSimultaneousAvatars": 48,
    "maxDrawCallsPerAvatar": 3,
    "maxTrianglesPerComposedAvatar": 2200
  },
  "classes": {
    "body": { "maxTriangles": 1100, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "head": { "maxTriangles": 280, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "hair": { "maxTriangles": 220, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "torso": { "maxTriangles": 700, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "legs": { "maxTriangles": 520, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "headwear": { "maxTriangles": 360, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "back": { "maxTriangles": 320, "maxMaterials": 1, "maxWeightError": 0.0001 },
    "held": { "maxTriangles": 400, "maxMaterials": 1, "maxBytes": 65536 },
    "prop": { "maxTriangles": 650, "maxMaterials": 1, "maxBytes": 81920 },
    "levelProp": { "maxTriangles": 3600, "maxMaterials": 1, "maxBytes": 524288 }
  }
}
