{
  "name": "pirate-nation-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "description": "Art & audio showcase for the MIT-licensed Pirate Nation asset pack (Proof of Play). Browse 355 models (plus 20 collision meshes via a viewer toggle) with animation playback, compose pirates in the Avatar Lab, and preview 513 sprites and 30 audio tracks.",
  "keywords": [
    "RUN.game"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "thumbnails": "node --import tsx scripts/render-thumbnails.ts",
    "export:jam-assets": "node --import tsx scripts/export-to-jam-assets.ts",
    "deploy": "npm run build && rundot deploy"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.0",
    "@react-three/fiber": "^8.17.0",
    "@series-inc/rundot-game-sdk": "5.28.0-beta.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "~0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "~0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "firebase": "^12.18.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
