{
  "name": "inkline-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Original drawn-stick 3D asset pack and industrial district showcase for RUN.",
  "scripts": {
    "assets:build": "python3 scripts/build-assets.py",
    "assets:export": "node --import tsx scripts/export-pack.ts",
    "assets:verify": "node --import tsx scripts/verify-assets.ts",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 0.0.0.0 --port 5197",
    "pack:link": "tsx scripts/link-pack.ts",
    "preassets:export": "npm run pack:link",
    "preassets:verify": "npm run pack:link",
    "prebuild": "npm run pack:link",
    "predev": "npm run pack:link",
    "pretest": "npm run pack:link",
    "pretest:e2e": "npm run pack:link",
    "preview": "vite preview --host 0.0.0.0 --port 4197",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "~0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "~0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
