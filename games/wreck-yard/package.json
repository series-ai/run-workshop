{
  "name": "wreck-yard",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer voxel destruction yard: torch, throw, and sink voxel bodies in one deterministic syncplay session.",
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "keywords": [
    "RUN.game"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run identity:check && tsc && vite build",
    "preview": "vite preview --port 4398 --strictPort --host 127.0.0.1",
    "identity:generate": "node scripts/generate-identity.mjs",
    "identity:check": "node scripts/generate-identity.mjs --check",
    "deploy": "npm run build && rundot deploy --orientation Landscape",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@series-inc/rundot-game-sdk": "5.28.0",
    "@series-inc/rundot-syncplay": "6.0.0-rc.77",
    "fflate": "0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "~0.170.0",
    "voxel-kit": "file:../../tools/voxel-kit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "~0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase": "^12.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.10"
  }
}
