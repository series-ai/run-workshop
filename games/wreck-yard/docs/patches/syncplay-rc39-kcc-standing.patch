+  const geometry = normalizeKccGeometry3D(previous);
+  const shape = {
+    type: 'capsule' as const,
+    radius: meters(geometry.radius + geometry.skinWidth),
+    halfHeight: meters(geometry.halfHeight + geometry.skinWidth),
+  };
+  let { x, y, z } = previous;
+  let corrections = 0;
+  for (let pass = 0; pass < 4; pass += 1) {
+    stats.queryCount += 1;
+    const hits = physics.overlap({
+      shape, x: meters(x), y: meters(y), z: meters(z),
+      layerMask: 0b1111, hitTriggers: false, hitSensors: false, maxPortalDepth: 0,
+    });
+    const accepted = filterKccSolidHits(physics, hits, { ...context, sample: pass }, stats, x, y, z);
+    const separations: {
+      hit: PhysicsCastHit3D; depth: number; nx: number; ny: number; nz: number;
+    }[] = [];
+    for (const hit of accepted) {
+      const length = solverSqrt(hit.normal.x * hit.normal.x + hit.normal.y * hit.normal.y + hit.normal.z * hit.normal.z);
+      if (length < 1e-8) continue;
+      const nx = hit.normal.x / length;
+      const ny = hit.normal.y / length;
+      const nz = hit.normal.z / length;
+      const support = shape.radius + shape.halfHeight * Math.abs(ny);
+      const along = (hit.point.x - x) * nx + (hit.point.y - y) * ny + (hit.point.z - z) * nz;
+      // The native overlap point is the midpoint of the overlap interval.
+      const depth = 2 * (support - along);
+      if (depth > 1e-6) separations.push({ hit, depth, nx, ny, nz });
+    }
+    separations.sort((left, right) => right.depth - left.depth
+      || comparePhysicsBodyIds(left.hit.bodyId, right.hit.bodyId)
+      || left.hit.childIndex - right.hit.childIndex);
