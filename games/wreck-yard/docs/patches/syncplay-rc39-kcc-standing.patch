+interface KccPhysicsQueryStats {
+  queryCount: number;
+  collisionFilterCalls: number;
+  collisionFilterRejectedHits: number;
+}
+
+function filterKccSolidHits(
+  physics: PhysicsWorld3D,
+  hits: readonly PhysicsCastHit3D[],
+  context: KccPhysicsOverlapFilterContext,
+  stats: KccPhysicsQueryStats,
+  x: number,
+  y: number,
+  z: number,
+): readonly PhysicsCastHit3D[] {
+  const before = deterministicKccCollisionFiltersStateChecksum(context.collisionFilters);
+  const filters = sortKccCollisionFilters(context.collisionFilters);
+  const accepted: PhysicsCastHit3D[] = [];
+  const ordered = [...hits].sort((left, right) => comparePhysicsBodyIds(left.bodyId, right.bodyId)
+    || left.childIndex - right.childIndex);
+  for (const hit of ordered) {
+    if (context.ignoredBodyIds.has(hit.bodyId)) continue;
+    const body = readKccPhysicsBody(physics, hit.bodyId);
+    if (body.trigger || body.sensor) continue;
+    const candidate = {
+      ...createKccCollisionCandidate(hit.bodyId, body, context, x, y, z),
+      normalX: -hit.normal.x, normalY: -hit.normal.y, normalZ: -hit.normal.z,
+    };
+    let keep = true;
+    for (const filter of filters) {
+      stats.collisionFilterCalls += 1;
+      if (!filter.shouldCollide(candidate)) {
+        stats.collisionFilterRejectedHits += 1;
+        keep = false;
+        break;
+      }
+    }
+    if (keep) accepted.push(hit);
+  }
+  assertKccCollisionFiltersUnchanged(context.collisionFilters, before);
+  return accepted;
+}
