{
  "name": "stick-zone",
  "version": "1.0.0",
  "description": "High-Action 3D Stickman Extraction Shooter in Sector 7 Depot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5196",
    "build": "tsc && vite build && npx esbuild src/sim/server-settlement.ts --outfile=src/sim/server-settlement.js --format=esm --platform=node",
