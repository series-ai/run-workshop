{
  "name": "run-voxel-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "description": "Showcase for the RUN voxel asset packs (fantasy, space, monster, post-apocalypse) side by side with Pirate Nation: model gallery, mixed-pack scene, cross-pack Avatar Lab.",
  "keywords": [
    "RUN.game"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:local": "tsc -p tsconfig.json --noEmit && vite build --mode local-preview",
    "preview": "vite preview --mode local-preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "thumbnails": "node --import tsx scripts/render-thumbnails.ts",
    "deploy": "npm run build && rundot deploy"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@series-inc/rundot-game-sdk": "^5.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "~0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "~0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
